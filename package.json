{
  "name": "dsh-brand-logo",
  "version": "1.1.0",
  "description": "Rebrand the DeepSeek Harness sidebar from Settings: your own image or a typeset wordmark, editable live.",
  "license": "MIT",
  "author": {
    "name": "squidwantyou",
    "email": "605378861@qq.com",
    "url": "https://github.com/squidwantyou"
  },
  "homepage": "https://github.com/squidwantyou/dsh-brand-logo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squidwantyou/dsh-brand-logo.git"
  },
  "bugs": {
    "url": "https://github.com/squidwantyou/dsh-brand-logo/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "brand",
    "logo",
    "wordmark",
    "sidebar",
    "theming",
    "white-label"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "docs",
    "tools"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
